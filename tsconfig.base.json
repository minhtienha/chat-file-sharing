{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "baseUrl": ".",
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@sharing/common": ["libs/common/src/index.ts"],
      "@sharing/models": ["libs/models/src/index.ts"],
      "@sharing/smc": ["libs/smc/gridfs/src/index.ts"],
      "@sharing/interface/smc": ["libs/smc/interface/index.ts"]
    }
  }
}
